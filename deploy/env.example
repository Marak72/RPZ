# Пример файла окружения для production.
# Скопируйте в корень проекта как .env и заполните реальными значениями:
#   cp deploy/env.example /opt/fstec-rpz/.env
#   chmod 600 /opt/fstec-rpz/.env
# Файл .env в .gitignore и в репозиторий не попадает.

# Ключ подписи сессий Flask. Сгенерировать:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME

# Ключ шифрования паролей SSH (Fernet). Сгенерировать:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ВАЖНО: при смене ключа ранее сохранённые пароли расшифровать нельзя.
RPZ_FERNET_KEY=CHANGE_ME

# Работа за обратным прокси на подпути (включает доверие X-Forwarded-* и Secure-cookie).
BEHIND_PROXY=1

# Путь к файлу RPZ-зоны по умолчанию (можно переопределить в настройках через веб).
DEFAULT_ZONE_PATH=/var/named/master/rpz.block.db
