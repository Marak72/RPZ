# systemd-юнит для запуска портала ИБ через gunicorn.
# Скопировать в /etc/systemd/system/soc-portal.service и поправить пути/пользователя.
#
#   sudo cp deploy/soc-portal.service /etc/systemd/system/soc-portal.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now soc-portal
#   sudo systemctl status soc-portal

[Unit]
Description=Portal IB: FSTEC RPZ and SkyDNS threats (gunicorn)
After=network.target

[Service]
Type=simple
# Пользователь, от которого работает приложение (создайте при необходимости).
User=www-data
Group=www-data

# Каталог, куда склонирован репозиторий.
WorkingDirectory=/opt/fstec-rpz

# Секреты и параметры окружения (см. deploy/env.example).
EnvironmentFile=/opt/fstec-rpz/.env

# gunicorn из виртуального окружения проекта.
# --timeout: поиск конечных хостов в MaxPatrol SIEM выполняется синхронно
# в запросе, пачка доменов не укладывается в стандартные 30 секунд.
ExecStart=/opt/fstec-rpz/venv/bin/gunicorn \
    --workers 3 \
    --timeout 180 \
    --bind 127.0.0.1:8000 \
    --access-logfile - \
    --error-logfile - \
    wsgi:application

Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
